<Window x:Class="SolarSim.Preview.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About solarSim"
        Icon="pack://application:,,,/Assets/solarsim-logo.ico"
        Width="420" Height="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgBrush}"
        FontFamily="{StaticResource UiFont}"
        ShowInTaskbar="False">
    <DockPanel Margin="24">
        <Button DockPanel.Dock="Bottom" Content="OK" Style="{StaticResource PrimaryButton}"
                Padding="20,8" HorizontalAlignment="Right" IsDefault="True" IsCancel="True"
                Click="Ok_Click" Margin="0,16,0,0"/>
        <StackPanel>
            <Image Style="{StaticResource AppLogoMark}" Width="64" Height="64" Margin="0,0,0,14"
                   HorizontalAlignment="Left"/>
            <TextBlock x:Name="TitleText" Text="solarSim"
                       FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}"/>
            <TextBlock x:Name="VersionText" Text="" Margin="0,4,0,14"
                       Foreground="{DynamicResource MutedBrush}" FontSize="12.5"/>
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" FontSize="12.5"
                       LineHeight="20"
                       Text="Visual solar design lab for Windows. Design / simulation aid only — not stamped electrical, structural, or bankable-yield approval.&#10;&#10;Projects stay on this computer only (no cloud sync).&#10;&#10;Owned by Salutatorian — see LICENSE. Please do not fork."/>
        </StackPanel>
    </DockPanel>
</Window>
