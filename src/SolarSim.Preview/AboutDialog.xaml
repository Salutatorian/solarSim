<Window x:Class="SolarSim.Preview.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="About solarSim"
        Icon="pack://application:,,,/Assets/solarsim-logo.ico"
        Width="420" Height="400"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{DynamicResource BgBrush}"
        FontFamily="{StaticResource UiFont}"
        ShowInTaskbar="False">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            ResizeBorderThickness="0"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            Background="{DynamicResource BgBrush}">
        <DockPanel>
            <Border DockPanel.Dock="Top" Height="40"
                    Background="{DynamicResource ChromeBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <DockPanel Margin="14,0,6,0">
                    <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource DialogChromeButton}"
                            Click="Ok_Click" ToolTip="Close"/>
                    <TextBlock Text="About" FontFamily="{StaticResource DisplayFont}" FontSize="13"
                               FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                               VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <Button DockPanel.Dock="Bottom" Content="OK" Style="{StaticResource PrimaryButton}"
                    Padding="20,8" HorizontalAlignment="Right" IsDefault="True" IsCancel="True"
                    Click="Ok_Click" Margin="24,0,24,16"/>

            <StackPanel Margin="24,18,24,8">
                <Image Style="{StaticResource AppLogoMark}" Width="56" Height="56" Margin="0,0,0,14"
                       HorizontalAlignment="Left"/>
                <TextBlock x:Name="TitleText" Text="solarSim"
                           FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"/>
                <TextBlock x:Name="VersionText" Text="" Margin="0,4,0,14"
                           Foreground="{DynamicResource MutedBrush}" FontSize="12.5"/>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" FontSize="12.5"
                           LineHeight="20"
                           Text="Visual solar design lab for Windows. Design / simulation aid only — not stamped electrical, structural, or bankable-yield approval.&#10;&#10;Projects stay on this computer only (no cloud sync).&#10;&#10;Owned by Salutatorian — see LICENSE. Please do not fork."/>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
