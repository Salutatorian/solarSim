<UserControl x:Class="SolarSim.Preview.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SolarSim.Preview"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             Background="{DynamicResource BgBrush}"
             FontFamily="{StaticResource UiFont}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Brand column -->
        <Border Grid.Column="0" ClipToBounds="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#042F2E" Offset="0"/>
                    <GradientStop Color="#09090B" Offset="0.55"/>
                    <GradientStop Color="#0C0C0E" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Ellipse Width="280" Height="280" HorizontalAlignment="Left" VerticalAlignment="Top"
                         Margin="-80,-60,0,0" Opacity="0.35">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#2DD4BF" Offset="0"/>
                            <GradientStop Color="#00000000" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <DockPanel Margin="36,28,28,28">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,0">
                        <Image Style="{StaticResource AppLogoMark}" Width="28" Height="28" Margin="0,0,10,0"/>
                        <TextBlock Text="solarSim" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold"
                                   FontSize="16" Foreground="#FAFAFA" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                        <TextBlock x:Name="HomeVersionText" Foreground="#A1A1AA" FontSize="11.5"/>
                        <TextBlock Text="Projects stay on this PC. Apache-2.0."
                                   Foreground="#A1A1AA" FontSize="11.5" Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel VerticalAlignment="Center" Margin="0,24,0,24">
                        <TextBlock Text="ROOF  →  ARRAY  →  ONE-LINE" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#5EEAD4" Margin="0,0,0,16"/>
                        <TextBlock Text="Lay out the roof.&#10;Wire the array."
                                   FontFamily="{StaticResource DisplayFont}" FontSize="36" FontWeight="SemiBold"
                                   Foreground="#FAFAFA" TextWrapping="Wrap" LineHeight="44"/>
                        <TextBlock Text="A local CAD lab for modules, strings, and equipment — not a stamp, not the cloud."
                                   TextWrapping="Wrap" Foreground="#A1A1AA" FontSize="14" Margin="0,16,0,28" LineHeight="22"/>
                        <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                            <Border Width="6" Height="6" CornerRadius="3" Background="#2DD4BF" Margin="0,5,10,0"/>
                            <TextBlock Text="Trace roofs from a free map" Foreground="#E4E4E7" FontSize="13"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                            <Border Width="6" Height="6" CornerRadius="3" Background="#2DD4BF" Margin="0,5,10,0"/>
                            <TextBlock Text="String, rack, and BOM in one file" Foreground="#E4E4E7" FontSize="13"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="6" Height="6" CornerRadius="3" Background="#2DD4BF" Margin="0,5,10,0"/>
                            <TextBlock Text="Offline by default" Foreground="#E4E4E7" FontSize="13"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>

        <!-- Workspace column -->
        <Border Grid.Column="1" Background="{DynamicResource BgBrush}">
            <Grid Margin="28,0,28,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource GhostButton}" Width="40" Height="32" Padding="0"
                            Click="Minimize_Click" ToolTip="Minimize"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <local:AppIcon Kind="Minimize" Width="12" Height="12"/>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Width="44" Height="32" Padding="0"
                            Click="Close_Click" ToolTip="Close"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <local:AppIcon Kind="Close" Width="12" Height="12"/>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <TextBlock Text="Start a file" FontFamily="{StaticResource DisplayFont}"
                               FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock Text="Name it, pick a folder, then open the canvas."
                               Foreground="#E4E4E7" FontSize="13.5" Margin="0,4,0,12"/>

                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="14" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="New project" FontWeight="SemiBold" FontSize="14"
                                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10"/>
                            <TextBlock Text="Name" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="NameBox" Height="36" Text="Untitled" Margin="0,0,0,10"
                                     VerticalContentAlignment="Center"/>
                            <TextBlock Text="Folder" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"/>
                            <Grid Height="36" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="PathBox" Height="36" IsReadOnly="True"
                                         MinWidth="0"
                                         VerticalContentAlignment="Center"
                                         TextWrapping="NoWrap"
                                         HorizontalScrollBarVisibility="Hidden"
                                         ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                         Text="Choose a folder…"/>
                                <Button Grid.Column="1" Content="Browse" Style="{StaticResource ModernButtonBase}"
                                        Margin="8,0,0,0" Padding="16,0" Height="36" Click="Browse_Click"/>
                            </Grid>
                            <Button Content="Create project" Style="{StaticResource PrimaryButton}"
                                    Height="38" FontSize="14" Click="Create_Click" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Button Grid.Row="3" MinHeight="0"
                        Padding="16,12" Style="{StaticResource ModernButtonBase}"
                        HorizontalContentAlignment="Left"
                        Click="OpenExisting_Click" HorizontalAlignment="Stretch">
                    <StackPanel>
                        <TextBlock Text="Open existing" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Text="Pick a .solarproj on this computer"
                                   Foreground="#E4E4E7" FontSize="12" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>

                <DockPanel Grid.Row="5">
                    <TextBlock x:Name="HomeError" DockPanel.Dock="Top"
                               Foreground="{DynamicResource DangerBrush}"
                               TextWrapping="Wrap" FontSize="12.5"
                               Visibility="Collapsed" Margin="0,0,0,8"/>
                    <TextBlock DockPanel.Dock="Top" Text="Recent"
                               FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold"
                               FontSize="15" Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock DockPanel.Dock="Top" Text="Double-click a file to reopen it"
                               Foreground="#E4E4E7" FontSize="12" Margin="0,2,0,8"/>
                    <TextBlock x:Name="RecentEmpty" DockPanel.Dock="Top"
                               Text="Nothing here yet — create a project above."
                               Foreground="#E4E4E7" FontSize="13"
                               Visibility="Collapsed"/>
                    <ListBox x:Name="RecentList" BorderThickness="0" Background="Transparent"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             MouseDoubleClick="RecentList_DoubleClick"
                             KeyDown="RecentList_KeyDown"/>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
