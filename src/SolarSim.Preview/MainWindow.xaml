<Window x:Class="SolarSim.Preview.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="solarSim"
        Icon="pack://application:,,,/Assets/solarsim-logo.ico"
        Width="1440" Height="900"
        MinWidth="1100" MinHeight="700"
        Background="{DynamicResource BgBrush}"
        FontFamily="{StaticResource UiFont}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Grid>
    <DockPanel Background="{DynamicResource BgBrush}">
        <Border DockPanel.Dock="Top" Background="{DynamicResource ChromeBrush}" Height="40"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Image Style="{StaticResource AppLogoMark}" Width="22" Height="22" Margin="0,0,8,0"
                           VerticalAlignment="Center"/>
                    <TextBlock Text="solarSim" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold"
                               FontSize="13" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="AppVersionLabel" Text="0.1.11" Foreground="{DynamicResource MutedBrush}"
                               FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="design aid" Foreground="{DynamicResource MutedBrush}" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,14,0" Opacity="0.85"
                               ToolTip="Not stamped electrical, structural, or bankable-yield approval."/>
                    <Button x:Name="FileMenuButton" Content="Untitled" Style="{StaticResource GhostButton}"
                            Click="OverflowMenu_Click" Padding="8,4" FontSize="13"
                            Foreground="{DynamicResource TextBrush}"
                            ToolTip="Project menu"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="RoofPlanButton" Content="Roof" Style="{StaticResource NavTabButton}" Click="RoofPlan_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button x:Name="InteriorPlanButton" Content="Equipment" Style="{StaticResource NavTabButton}" Click="InteriorPlan_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button x:Name="CombinedPlanButton" Content="System" Style="{StaticResource NavTabButton}" Click="CombinedPlan_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button Content="↶" Style="{StaticResource IconGhostButton}" Width="34" Click="Undo_Click" ToolTip="Undo"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Content="↷" Style="{StaticResource IconGhostButton}" Width="34" Click="Redo_Click" ToolTip="Redo" Margin="0,0,6,0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button x:Name="ThemeToggleButton" Content="◐" Style="{StaticResource IconGhostButton}" Width="34"
                            Click="ThemeToggle_Click" ToolTip="Theme" Margin="0,0,6,0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Content="Save" Style="{StaticResource PrimaryButton}" Padding="14,5" Click="Save_Click" Margin="0,0,6,0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Grid Width="34" Height="32" Margin="0,0,6,0">
                        <Button x:Name="SettingsGearButton" Content="⚙" Style="{StaticResource IconGhostButton}" Width="34"
                                Click="Settings_Click" ToolTip="Settings"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Ellipse x:Name="SettingsUpdateBadge" Width="9" Height="9" Fill="#EF4444"
                                 HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0"
                                 Visibility="Collapsed" IsHitTestVisible="False"/>
                    </Grid>
                    <Button x:Name="OverflowMenuButton" Content="⋯" Style="{StaticResource IconGhostButton}" Width="34"
                            Click="OverflowMenu_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Open Project…" Click="Open_Click"/>
                                <MenuItem Header="Save As…" Click="SaveAs_Click"/>
                                <MenuItem Header="Project Settings…" Click="ProjectSettings_Click"/>
                                <Separator/>
                                <MenuItem Header="Single-Line Diagram" Click="SingleLine_Click"/>
                                <MenuItem Header="BOM / Wire Schedule" Click="BomSchedule_Click"/>
                                <MenuItem Header="Export Report (HTML/PDF)…" Click="ExportReport_Click"/>
                                <Separator/>
                                <MenuItem Header="Google Solar import (optional paid)…" Click="ImportGoogleSolar_Click"/>
                                <MenuItem Header="Google API key (optional)…" Click="SetGoogleApiKey_Click"/>
                                <MenuItem Header="pvlib Status…" Click="PvlibStatus_Click"/>
                                <Separator/>
                                <MenuItem Header="Demo Roof (12×8 m)" Click="DemoRoof_Click"/>
                                <MenuItem Header="Demo L-Roof" Click="DemoLRoof_Click"/>
                                <MenuItem Header="Clear Roof" Click="ClearRoof_Click"/>
                                <Separator/>
                                <MenuItem Header="Settings…" Click="Settings_Click"/>
                                <MenuItem Header="About solarSim…" Click="About_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button x:Name="DeleteButton" Visibility="Collapsed" Click="Delete_Click"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Stretch">
                    <Button Content="─" Style="{StaticResource TitleBarButton}" Click="Minimize_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button x:Name="MaximizeButton" Content="□" Style="{StaticResource TitleBarButton}" Click="Maximize_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Content="✕" Style="{StaticResource TitleBarButton}" Click="CloseWindow_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{DynamicResource ChromeBrush}" Height="44" Padding="14,0"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="HudModules" Text="0 modules" Foreground="{DynamicResource TextBrush}"
                               FontSize="12.5" FontWeight="SemiBold" Margin="0,0,18,0"/>
                    <TextBlock x:Name="HudPower" Text="0 W DC" Foreground="{DynamicResource TextBrush}"
                               FontSize="12.5" FontWeight="SemiBold" Margin="0,0,18,0"/>
                    <TextBlock x:Name="HudStrings" Text="0 strings" Foreground="{DynamicResource MutedBrush}"
                               FontSize="12.5" Margin="0,0,18,0"/>
                    <TextBlock x:Name="HudHealth" Text="✓ No issues" Foreground="{DynamicResource OkBrush}"
                               FontSize="12.5"/>
                    <TextBlock x:Name="StatusText" Visibility="Collapsed"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="HudDetail" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,16,0" MaxWidth="420" TextTrimming="CharacterEllipsis"/>
                    <Button Content="Properties" Style="{StaticResource GhostButton}" Click="ToggleInspector_Click"
                            Padding="8,4" Margin="0,0,10,0"/>
                    <Button Content="−" Style="{StaticResource IconGhostButton}" Width="28" Click="ZoomOut_Click"/>
                    <TextBlock x:Name="ZoomLabel" Text="100%" Width="48" TextAlignment="Center"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" FontSize="12"/>
                    <Button Content="+" Style="{StaticResource IconGhostButton}" Width="28" Click="ZoomIn_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48"/>
                <ColumnDefinition x:Name="SidePanelColumn" Width="0"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="InspectorColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource BgBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Button x:Name="LayersRailButton" DockPanel.Dock="Bottom" Style="{StaticResource ToolRailButton}"
                            Click="LayersDrawerToggle_Click" Margin="0,0,0,8" ToolTip="Layers" Content="☰"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,10,0,0">
                            <Button x:Name="ToolSelectButton" Style="{StaticResource ToolRailButton}" Click="ToolSelect_Click" ToolTip="Select" Content="↖"/>
                            <Button x:Name="ToolRoofButton" Style="{StaticResource ToolRailButton}" Click="ToolRoof_Click" ToolTip="Roof" Content="⌂"/>
                            <Button x:Name="ToolPanelButton" Style="{StaticResource ToolRailButton}" Click="ToolPanel_Click" ToolTip="Panels" Content="▦"/>
                            <Button x:Name="ToolWireButton" Style="{StaticResource ToolRailButton}" Click="ToolWire_Click" ToolTip="Wire" Content="⌁"/>
                            <Button x:Name="ToolObstacleButton" Style="{StaticResource ToolRailButton}" Click="ToolObstacle_Click" ToolTip="Obstacle" Content="◇"/>
                            <Button x:Name="ToolMeasureButton" Style="{StaticResource ToolRailButton}" Click="ToolMeasure_Click" ToolTip="Measure" Content="↔"/>
                            <Button x:Name="ToolAddButton" Style="{StaticResource ToolRailButton}" Click="ToolAdd_Click" ToolTip="Add" Content="+"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border x:Name="SidePanel" Grid.Column="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0" Visibility="Collapsed">
                <DockPanel Margin="14,12,10,12">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource IconGhostButton}"
                                Width="28" Height="28" Click="CloseSidePanel_Click"/>
                        <TextBlock x:Name="ContextTitle" Text="Roof" FontWeight="SemiBold" FontSize="15"
                                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Roof -->
                            <StackPanel x:Name="RoofContextPanel" Visibility="Collapsed">
                                <Button x:Name="DrawRoofButton" Content="Draw roof" Style="{StaticResource PaletteRowButton}" Click="DrawRoof_Click"/>
                                <Button Content="Trace roof on map…" Style="{StaticResource PaletteRowButton}" Click="SatelliteMap_Click"/>
                                <Button Content="New roof layer" Style="{StaticResource PaletteRowButton}" Click="NewRoofLayer_Click"/>
                                <Button Content="Close polygon" Style="{StaticResource PaletteRowButton}" Click="CloseRoof_Click"/>
                                <Button Content="Straighten edges" Style="{StaticResource PaletteRowButton}" Click="StraightenRoof_Click"
                                        ToolTip="One-click: align house + snap every edge horizontal/vertical. Also runs automatically after map import. Dragging corners snaps to straight (Alt = free)."/>
                                <Button Content="Rotate roof 15°" Style="{StaticResource PaletteRowButton}" Click="RotateRoof15_Click"
                                        ToolTip="Nudge 15° (Shift = −15°). Or drag the ↻ button — snaps to 90° when close."/>
                                <Button x:Name="LockRoofButton" Content="Unlock roof" Style="{StaticResource PaletteRowButton}" Click="ToggleRoofLock_Click"
                                        ToolTip="Import locks corners/move so box-select doesn't nudge the house. Drag the ↻ handle under the roof to rotate anytime. Unlock only to edit corners or Alt+drag-move."/>
                                <TextBlock Text="Setback" Style="{StaticResource FieldLabel}" Margin="0,12,0,6"/>
                                <DockPanel>
                                    <TextBlock x:Name="SetbackLabel" DockPanel.Dock="Right" Text="mm" Style="{StaticResource FieldLabel}" Margin="8,0,0,0"/>
                                    <TextBox x:Name="SetbackBox" Text="457.2" LostFocus="SetbackBox_LostFocus" KeyDown="SetbackBox_KeyDown"/>
                                </DockPanel>
                                <StackPanel x:Name="ImportRoofPanel" Visibility="Collapsed" Margin="0,14,0,0">
                                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12.5"
                                               Text="Free map: search address → zoom → click each roof corner → Import. No Google billing."/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Panels -->
                            <StackPanel x:Name="PanelContextPanel" Visibility="Collapsed">
                                <Button Content="Boviet 270 W" Style="{StaticResource PaletteRowButton}" Click="AddBoviet_Click"/>
                                <Button Content="Generic 400 W" Style="{StaticResource PaletteRowButton}" Click="AddGeneric400_Click"/>
                                <Button Content="Generic 550 W" Style="{StaticResource PaletteRowButton}" Click="AddGeneric550_Click"/>
                                <Button Content="Custom panel…" Style="{StaticResource PaletteRowButton}" Click="AddCustom_Click"/>
                            </StackPanel>

                            <!-- Wire -->
                            <StackPanel x:Name="WireContextPanel" Visibility="Collapsed">
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12.5" LineHeight="18"
                                           Text="Select a panel, then drag from PV+ to a compatible PV−. Right-click a wire to disconnect."/>
                            </StackPanel>

                            <!-- Obstacle -->
                            <StackPanel x:Name="ObstacleContextPanel" Visibility="Collapsed">
                                <Button x:Name="AddObstacleButton" Content="Place roof vent" Style="{StaticResource PaletteRowButton}"
                                        Click="AddObstacleMode_Click"/>
                            </StackPanel>

                            <!-- Add / library -->
                            <Border x:Name="AddPalette" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBox x:Name="AddSearchBox" Margin="0,0,0,12" Padding="8,7"
                                             Background="{DynamicResource HoverBrush}"
                                             Foreground="{DynamicResource TextBrush}"
                                             BorderBrush="{DynamicResource BorderBrush}"
                                             CaretBrush="{DynamicResource TextBrush}"
                                             Tag="Search components…"
                                             TextChanged="AddSearch_TextChanged"/>

                                    <StackPanel x:Name="AddRecentSection" Visibility="Collapsed" Margin="0,0,0,12">
                                        <TextBlock Text="Recent" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                                        <WrapPanel x:Name="AddRecentTiles"/>
                                    </StackPanel>

                                    <StackPanel x:Name="AddSolarSection" Margin="0,0,0,12">
                                        <TextBlock Text="Solar" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                                        <WrapPanel x:Name="AddSolarTiles"/>
                                    </StackPanel>

                                    <StackPanel x:Name="AddElectricalSection" Margin="0,0,0,12">
                                        <TextBlock Text="Electrical" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                                        <WrapPanel x:Name="AddElectricalTiles"/>
                                    </StackPanel>

                                    <StackPanel x:Name="AddStructuralSection">
                                        <TextBlock Text="Structural" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                                        <WrapPanel x:Name="AddStructuralTiles"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Layers -->
                            <Border x:Name="LayersDrawer" Visibility="Collapsed">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                        <Button x:Name="LayersRoofsTab" Content="Roofs" Style="{StaticResource SegmentButton}" Click="LayersRoofsTab_Click"/>
                                        <Button x:Name="LayersPanelsTab" Content="Panels" Style="{StaticResource SegmentButton}" Click="LayersPanelsTab_Click"/>
                                        <Button x:Name="LayersEquipmentTab" Content="Equipment" Style="{StaticResource SegmentButton}" Click="LayersEquipmentTab_Click"/>
                                    </StackPanel>
                                    <StackPanel x:Name="RoofLayerActions" DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Content="New layer" Padding="10,6" Margin="0,0,6,0" Click="NewRoofLayer_Click"/>
                                        <Button Content="Delete" Style="{StaticResource DangerButton}" Padding="10,6" Click="DeleteRoofLayer_Click"/>
                                    </StackPanel>
                                    <ListBox x:Name="LayerList" BorderThickness="0" Background="Transparent"
                                             SelectionChanged="LayerList_SelectionChanged"
                                             MouseDoubleClick="LayerList_MouseDoubleClick"/>
                                </DockPanel>
                            </Border>

                            <StackPanel x:Name="MeasureContextPanel" Visibility="Collapsed">
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12.5"
                                           Text="Click two or more points on the canvas. Live edge lengths appear as you move — same style as Draw roof. Esc clears the measure."/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Hero canvas stage -->
            <Border Grid.Column="2" Background="{DynamicResource CanvasBrush}" ClipToBounds="True">
                <Grid>
                    <Rectangle x:Name="CanvasGridRect" Fill="{DynamicResource CanvasDotBrush}"/>
                    <Canvas x:Name="DesignCanvas" Background="Transparent"
                            MouseWheel="Canvas_MouseWheel"
                            MouseDown="Canvas_MouseDown"
                            MouseMove="Canvas_MouseMove"
                            MouseUp="Canvas_MouseUp"
                            MouseLeave="Canvas_MouseLeave"
                            MouseRightButtonUp="Canvas_MouseRightButtonUp"/>

                    <!-- Soft empty state — no card -->
                    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Style="{StaticResource AppLogoMark}" Width="72" Height="72" Margin="0,0,0,18"
                               HorizontalAlignment="Center" Opacity="0.95"/>
                        <TextBlock x:Name="EmptyStateTitle" Text="Start with your roof"
                                   FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="EmptyStateBody" Text="Draw or trace a roof · design aid only — not stamped approval"
                                   FontSize="14" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" Margin="0,8,0,22"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="Draw roof" Style="{StaticResource PrimaryButton}" Width="118" Height="34"
                                    Click="EmptyStateDraw_Click" Margin="0,0,10,0"/>
                            <Button x:Name="EmptyStateButton" Content="Satellite map" Style="{StaticResource GhostButton}"
                                    Width="128" Height="34" Click="EmptyStateImport_Click"
                                    BorderBrush="{DynamicResource BorderBrush}" Foreground="{DynamicResource TextBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Floating selection toolbar (Figma-style) -->
                    <Border x:Name="ContextToolBar" Visibility="Collapsed"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="4,3"
                            Panel.ZIndex="80">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.35" Color="#000000"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="CtxRotateButton" Content="↻" Style="{StaticResource ContextActionButton}"
                                    ToolTip="Rotate 90° (R)" Click="CtxRotate_Click" Width="32" Padding="0"/>
                            <Button x:Name="CtxDuplicateButton" Content="Duplicate" Style="{StaticResource ContextActionButton}"
                                    ToolTip="Duplicate (Ctrl+D)" Click="CtxDuplicate_Click"/>
                            <Button x:Name="CtxStringButton" Content="String" Style="{StaticResource ContextActionButton}"
                                    ToolTip="Select string" Click="CtxString_Click" Margin="0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Properties inspector -->
            <Border x:Name="InspectorPanel" Grid.Column="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1,0,0,0" Visibility="Collapsed">
                <DockPanel Margin="16,12,12,12">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource IconGhostButton}"
                                Width="28" Click="ToggleInspector_Click"/>
                        <Button DockPanel.Dock="Right" Content="Delete" Style="{StaticResource DangerButton}"
                                Padding="10,5" FontSize="11" Click="Delete_Click" Margin="0,0,6,0"/>
                        <TextBlock Text="Properties" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <Border DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Strings" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                            <ListBox x:Name="StringsList" MaxHeight="120" BorderThickness="0" Background="Transparent"
                                     SelectionChanged="StringsList_SelectionChanged"/>
                        </DockPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="InspectorHeading" Text="Project" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"/>
                            <TextBlock x:Name="InspectorSubheading" FontSize="12.5"
                                       Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,14"
                                       Text="Nothing selected"/>
                            <StackPanel x:Name="InspectorRows"/>
                            <TextBlock x:Name="InspectorBody" TextWrapping="Wrap" FontSize="12.5" LineHeight="20"
                                       Foreground="{DynamicResource MutedBrush}" Visibility="Collapsed"/>

                            <StackPanel x:Name="SiteTempsPanel" Margin="0,18,0,0">
                                <TextBlock Text="Site" Style="{StaticResource SectionLabel}"/>
                                <ComboBox x:Name="UnitsCombo" Margin="0,0,0,8" SelectionChanged="UnitsCombo_SelectionChanged"/>
                                <ComboBox x:Name="ClimatePresetCombo" Margin="0,0,0,8" SelectionChanged="ClimatePresetCombo_SelectionChanged"/>
                                <TextBlock Text="Location" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                <TextBox x:Name="LocationNameBox" Text="Unspecified" Margin="0,0,0,6"
                                         LostFocus="SiteField_LostFocus" KeyDown="SiteField_KeyDown"/>
                                <TextBlock Text="Lat" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                <TextBox x:Name="LatitudeBox" Margin="0,0,0,6" LostFocus="SiteField_LostFocus" KeyDown="SiteField_KeyDown"/>
                                <TextBlock Text="Lon" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                <TextBox x:Name="LongitudeBox" Margin="0,0,0,6" LostFocus="SiteField_LostFocus" KeyDown="SiteField_KeyDown"/>
                                <TextBlock Text="Cold Voc" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                <TextBox x:Name="MinAmbientBox" Text="-10" Margin="0,0,0,6" LostFocus="SiteField_LostFocus" KeyDown="SiteField_KeyDown"/>
                                <TextBlock Text="Hot cell" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                <TextBox x:Name="HotCellBox" Text="70" Margin="0,0,0,6" LostFocus="SiteField_LostFocus" KeyDown="SiteField_KeyDown"/>
                                <TextBlock Text="PSH / day" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                <TextBox x:Name="PeakSunHoursBox" Text="4.5" Margin="0,0,0,6" LostFocus="SiteField_LostFocus" KeyDown="SiteField_KeyDown"/>
                                <TextBlock Text="Derate" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                <TextBox x:Name="DerateBox" Text="0.85" Margin="0,0,0,6" LostFocus="SiteField_LostFocus" KeyDown="SiteField_KeyDown"/>
                                <TextBlock Text="Tilt °" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                <TextBox x:Name="ArrayTiltBox" Text="20" Margin="0,0,0,6" LostFocus="SiteField_LostFocus" KeyDown="SiteField_KeyDown"/>
                                <TextBlock Text="Azimuth °" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                <TextBox x:Name="ArrayAzimuthBox" Text="180" Margin="0,0,0,8" LostFocus="SiteField_LostFocus" KeyDown="SiteField_KeyDown"/>
                                <TextBlock Text="Panel color" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" Visibility="Collapsed"/>
                                <ComboBox x:Name="PanelColorCombo" Margin="0,0,0,8" SelectionChanged="PanelColorCombo_SelectionChanged" Visibility="Collapsed"/>
                                <Button Content="Run pvlib yield" Style="{StaticResource PaletteRowButton}" Click="RunPvlibEstimate_Click"/>
                            </StackPanel>

                            <StackPanel x:Name="RackingPanel" Margin="0,16,0,0">
                                <TextBlock Text="Racking" Style="{StaticResource SectionLabel}"/>
                                <CheckBox x:Name="ShowAttachmentsCheck" Content="Show attachments" Margin="0,0,0,10"
                                          IsChecked="False" Checked="ShowAttachmentsCheck_Changed" Unchecked="ShowAttachmentsCheck_Changed"/>
                                <TextBlock Text="Rafter OC" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                <TextBox x:Name="RafterSpacingBox" Text="406.4" Margin="0,0,0,6" LostFocus="RackingBox_LostFocus" KeyDown="RackingBox_KeyDown"/>
                                <TextBlock Text="Rail OH" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                <TextBox x:Name="RailOverhangBox" Text="150" Margin="0,0,0,6" LostFocus="RackingBox_LostFocus" KeyDown="RackingBox_KeyDown"/>
                                <TextBlock Text="Edge inset" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                <TextBox x:Name="AttachmentEdgeBox" Text="200" Margin="0,0,0,8" LostFocus="RackingBox_LostFocus" KeyDown="RackingBox_KeyDown"/>
                                <TextBlock x:Name="RackingSummaryText" TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource MutedBrush}"
                                           Text="Place modules to estimate rails / attachments."/>
                            </StackPanel>

                            <StackPanel x:Name="RoofToolsPanel" Visibility="Collapsed"/>
                            <TextBlock x:Name="TipText" Visibility="Collapsed"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>

        <!-- Bottom-right update toast (local download ready) -->
        <Border x:Name="UpdateToast"
                Visibility="Collapsed"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,18,58" Padding="14,12"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="10" MaxWidth="320"
                shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Image Style="{StaticResource AppLogoMark}" Width="20" Height="20" Margin="0,0,8,0"
                           VerticalAlignment="Center"/>
                    <TextBlock x:Name="UpdateToastTitle" Text="Update ready"
                               FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" FontSize="13"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="UpdateToastBody" TextWrapping="Wrap" Margin="0,0,0,12"
                           Foreground="{DynamicResource MutedBrush}" FontSize="12"
                           Text="A new version is available. Update or Cancel."/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="UpdateToastCancelButton" Content="Cancel" Style="{StaticResource GhostButton}" Padding="10,5"
                            Click="UpdateToastLater_Click" Margin="0,0,6,0"/>
                    <Button x:Name="UpdateToastApplyButton" Content="Update" Style="{StaticResource PrimaryButton}" Padding="12,5"
                            Click="UpdateToastApply_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
