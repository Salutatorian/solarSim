<UserControl x:Class="SolarSim.Preview.WhatsNewDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SolarSim.Preview"
             Width="520" Height="520"
             MinWidth="420" MinHeight="360"
             Background="{DynamicResource BgBrush}"
             FontFamily="{StaticResource UiFont}"
             Focusable="True"
             PreviewKeyDown="Dialog_PreviewKeyDown">
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            Background="{DynamicResource BgBrush}">
        <DockPanel>
            <Border DockPanel.Dock="Top" Height="40"
                    Background="{DynamicResource ChromeBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <DockPanel Margin="14,0,6,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource DialogChromeButton}"
                            Click="Ok_Click" ToolTip="Close">
                        <local:AppIcon Kind="Close" Width="12" Height="12"/>
                    </Button>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Style="{StaticResource AppLogoMark}" Width="18" Height="18" Margin="0,0,8,0"
                               VerticalAlignment="Center"/>
                        <TextBlock Text="What's new" FontFamily="{StaticResource DisplayFont}" FontSize="13"
                                   FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Button DockPanel.Dock="Bottom" Content="Got it" Style="{StaticResource PrimaryButton}"
                    Padding="20,8" HorizontalAlignment="Right" IsDefault="True" IsCancel="True"
                    Click="Ok_Click" Margin="20,0,20,16"/>

            <DockPanel Margin="20,16,20,8">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                    <TextBlock x:Name="VersionText" Text="" FontSize="13"
                               Foreground="{DynamicResource TextBrush}" Margin="0,0,0,2"/>
                    <TextBlock x:Name="ReleasedText" Text="" FontSize="12"
                               Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>

                <Border Background="{DynamicResource ChromeBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="NotesText" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontSize="12.5" LineHeight="20"/>
                    </ScrollViewer>
                </Border>
            </DockPanel>
        </DockPanel>
    </Border>
</UserControl>
