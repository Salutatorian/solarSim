<Window x:Class="SolarSim.Preview.WhatsNewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="What's new"
        Icon="pack://application:,,,/Assets/solarsim-logo.ico"
        Width="520" Height="520"
        MinWidth="420" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource BgBrush}"
        FontFamily="{StaticResource UiFont}"
        ShowInTaskbar="False">
    <DockPanel Margin="22">
        <Button DockPanel.Dock="Bottom" Content="Got it" Style="{StaticResource PrimaryButton}"
                Padding="20,8" HorizontalAlignment="Right" IsDefault="True" IsCancel="True"
                Click="Ok_Click" Margin="0,16,0,0"/>

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Image Style="{StaticResource AppLogoMark}" Width="28" Height="28" Margin="0,0,10,0"
                       VerticalAlignment="Center"/>
                <TextBlock Text="What's new" FontFamily="{StaticResource DisplayFont}" FontSize="20"
                           FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="VersionText" Text="" FontSize="13"
                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,2"/>
            <TextBlock x:Name="ReleasedText" Text="" FontSize="12"
                       Foreground="{DynamicResource MutedBrush}"/>
        </StackPanel>

        <Border Background="{DynamicResource ChromeBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="NotesText" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextBrush}"
                           FontSize="12.5" LineHeight="20"/>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
