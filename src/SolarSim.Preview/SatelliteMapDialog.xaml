<Window x:Class="SolarSim.Preview.SatelliteMapDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Trace roof — free satellite map"
        Icon="pack://application:,,,/Assets/solarsim-logo.ico"
        Width="960" Height="700"
        MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        Background="{DynamicResource BgBrush}"
        FontFamily="{StaticResource UiFont}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="52"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            Background="{DynamicResource BgBrush}">
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{DynamicResource ChromeBrush}" Padding="12,10"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Image Style="{StaticResource AppLogoMark}" Width="22" Height="22" Margin="0,0,10,0"
                           VerticalAlignment="Center"/>
                    <DockPanel Grid.Column="1">
                        <Button DockPanel.Dock="Right" Content="Search" Style="{StaticResource PrimaryButton}"
                                Padding="14,6" Margin="8,0,0,0" Click="Search_Click"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <TextBox x:Name="SearchBox" VerticalContentAlignment="Center" Height="32"
                                 KeyDown="SearchBox_KeyDown"
                                 shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                 ToolTip="Free OpenStreetMap address search, or paste lat,lon"/>
                    </DockPanel>
                    <TextBlock x:Name="StatusText" Grid.Column="2" VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedBrush}" FontSize="12.5" Margin="16,0,8,0"
                               Text="Loading map…"/>
                    <Button Grid.Column="3" Content="✕" Style="{StaticResource DialogChromeButton}"
                            Click="Cancel_Click" ToolTip="Close" VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                </Grid>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="{DynamicResource ChromeBrush}" Padding="12,10"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Undo" Style="{StaticResource GhostButton}" Padding="12,6" Margin="0,0,8,0"
                                ToolTip="Undo last corner (Ctrl+Z)" Click="UndoCorner_Click"/>
                        <Button x:Name="FinishOutlineButton" Content="Finish outline" Style="{StaticResource GhostButton}"
                                Padding="12,6" Margin="0,0,8,0" IsEnabled="False"
                                ToolTip="Close the current outline (any number of sides). Or click the first corner on the map."
                                Click="FinishOutline_Click"/>
                        <Button x:Name="NewSectionButton" Content="New section" Style="{StaticResource GhostButton}"
                                Padding="12,6" Margin="0,0,8,0" IsEnabled="False"
                                ToolTip="Lock this outline and start another wing / layer"
                                Click="NewSection_Click"/>
                        <Button Content="Clear" Style="{StaticResource GhostButton}" Padding="12,6" Margin="0,0,8,0"
                                Click="ClearOutline_Click"/>
                        <Button Content="Cancel" Style="{StaticResource GhostButton}" Width="88" Margin="0,0,8,0"
                                Click="Cancel_Click"/>
                        <Button x:Name="ImportButton" Content="Import traced roof" Style="{StaticResource PrimaryButton}"
                                Padding="16,8" IsEnabled="False" Click="Import_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="PinLabel" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"
                               FontSize="12.5"
                               Text="Click every corner (any count) · click first point / Finish to close · not limited to 4 sides"/>
                </DockPanel>
            </Border>

            <Grid ClipToBounds="True">
                <wv2:WebView2 x:Name="MapView"
                              DefaultBackgroundColor="#FF0E0E10"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"/>
            </Grid>
        </DockPanel>
    </Border>
</Window>
