<UserControl x:Class="SolarSim.Preview.SatelliteMapDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SolarSim.Preview"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Background="{DynamicResource BgBrush}"
             FontFamily="{StaticResource UiFont}"
             Focusable="True"
             PreviewKeyDown="Window_PreviewKeyDown">
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0"
            Background="{DynamicResource BgBrush}">
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{DynamicResource ChromeBrush}" Padding="12,10"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Image Style="{StaticResource AppLogoMark}" Width="22" Height="22" Margin="0,0,10,0"
                           VerticalAlignment="Center"/>
                    <DockPanel Grid.Column="1">
                        <Button DockPanel.Dock="Right" Content="Search" Style="{StaticResource PrimaryButton}"
                                Padding="14,6" Margin="8,0,0,0" Click="Search_Click"/>
                        <TextBox x:Name="SearchBox" VerticalContentAlignment="Center" Height="32"
                                 KeyDown="SearchBox_KeyDown"
                                 ToolTip="Address or lat,lon"/>
                    </DockPanel>
                    <Button Grid.Column="2" Style="{StaticResource DialogChromeButton}"
                            Click="Cancel_Click" ToolTip="Close" VerticalAlignment="Center">
                        <local:AppIcon Kind="Close" Width="12" Height="12"/>
                    </Button>
                </Grid>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="{DynamicResource ChromeBrush}" Padding="10,8"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource IconGhostButton}" Width="36" Height="32" Margin="0,0,4,0"
                                ToolTip="How to trace" Click="ReplayTutorial_Click">
                            <local:AppIcon Kind="Help" Width="15" Height="15"/>
                        </Button>
                        <Button Style="{StaticResource IconGhostButton}" Width="36" Height="32" Margin="0,0,4,0"
                                ToolTip="Undo last corner (Ctrl+Z)" Click="UndoCorner_Click">
                            <local:AppIcon Kind="Undo" Width="15" Height="15"/>
                        </Button>
                        <Button x:Name="FinishOutlineButton" Style="{StaticResource IconGhostButton}" Width="36" Height="32"
                                Margin="0,0,4,0" IsEnabled="False"
                                ToolTip="Finish outline" Click="FinishOutline_Click">
                            <local:AppIcon Kind="Check" Width="15" Height="15"/>
                        </Button>
                        <Button x:Name="NewSectionButton" Style="{StaticResource IconGhostButton}" Width="36" Height="32"
                                Margin="0,0,4,0" IsEnabled="False"
                                ToolTip="New section" Click="NewSection_Click">
                            <local:AppIcon Kind="Plus" Width="15" Height="15"/>
                        </Button>
                        <Button Style="{StaticResource IconGhostButton}" Width="36" Height="32" Margin="0,0,12,0"
                                ToolTip="Clear" Click="ClearOutline_Click">
                            <local:AppIcon Kind="Trash" Width="15" Height="15"/>
                        </Button>
                        <Button x:Name="ImportButton" Content="Import" Style="{StaticResource PrimaryButton}"
                                Padding="16,8" IsEnabled="False" Click="Import_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="PinLabel" VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedBrush}" FontSize="12.5"
                               Text="Search, then click each corner"/>
                </DockPanel>
            </Border>

            <Grid ClipToBounds="True">
                <wv2:WebView2 x:Name="MapView"
                              DefaultBackgroundColor="#FF0E0E10"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"/>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
