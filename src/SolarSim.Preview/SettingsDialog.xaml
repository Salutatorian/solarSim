<UserControl x:Class="SolarSim.Preview.SettingsDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SolarSim.Preview"
             Width="480" Height="620"
             Background="{DynamicResource BgBrush}"
             FontFamily="{StaticResource UiFont}"
             Focusable="True"
             PreviewKeyDown="Dialog_PreviewKeyDown">
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            Background="{DynamicResource BgBrush}">
        <DockPanel>
            <Border DockPanel.Dock="Top" Height="40"
                    Background="{DynamicResource ChromeBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <DockPanel Margin="14,0,6,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource DialogChromeButton}"
                            Click="Close_Click" ToolTip="Close">
                        <local:AppIcon Kind="Close" Width="12" Height="12"/>
                    </Button>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Style="{StaticResource AppLogoMark}" Width="18" Height="18" Margin="0,0,8,0"
                               VerticalAlignment="Center"/>
                        <TextBlock Text="Settings" FontFamily="{StaticResource DisplayFont}" FontSize="13"
                                   FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="20,0,20,16">
                <Button Content="Close" Style="{StaticResource PrimaryButton}" Padding="16,8" IsCancel="True" IsDefault="True"
                        Click="Close_Click"/>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="20,16,20,8">
                <StackPanel>
                    <TextBlock Text="All project files stay on this computer. Updates only contact official GitHub Releases."
                               TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"
                               FontSize="12.5" Margin="0,0,0,16"/>

                    <TextBlock Text="Community &amp; legal" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                    <TextBlock Text="Open official pages in your browser. Use Issues for bugs and suggestions (templates guide you)."
                               TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                               Margin="0,0,0,10"/>
                    <WrapPanel Margin="0,0,0,4">
                        <Button Content="GitHub repo" Style="{StaticResource ModernButtonBase}" Padding="12,7"
                                Margin="0,0,8,8" Click="OpenRepo_Click"/>
                        <Button Content="Releases" Style="{StaticResource ModernButtonBase}" Padding="12,7"
                                Margin="0,0,8,8" Click="OpenReleases_Click"/>
                        <Button Content="License" Style="{StaticResource ModernButtonBase}" Padding="12,7"
                                Margin="0,0,8,8" Click="OpenLicense_Click"/>
                    </WrapPanel>
                    <WrapPanel Margin="0,0,0,8">
                        <Button Content="Report a bug…" Style="{StaticResource PrimaryButton}" Padding="12,7"
                                Margin="0,0,8,8" Click="OpenBug_Click"
                                ToolTip="Opens a guided bug form on GitHub"/>
                        <Button Content="Suggest an idea…" Style="{StaticResource ModernButtonBase}" Padding="12,7"
                                Margin="0,0,8,8" Click="OpenSuggestion_Click"
                                ToolTip="Opens a guided suggestion form on GitHub"/>
                        <Button Content="All issues" Style="{StaticResource GhostButton}" Padding="10,7"
                                Margin="0,0,8,8" Click="OpenIssues_Click"/>
                    </WrapPanel>

                    <TextBlock Text="Support solarSim" Style="{StaticResource SectionLabel}" Margin="0,8,0,8"/>
                    <TextBlock Text="Optional tips help keep development going. Opens Stripe Checkout in your browser — card details stay with Stripe, never this app."
                               TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                               Margin="0,0,0,10"/>
                    <WrapPanel Margin="0,0,0,8">
                        <Button Content="Donate $1" Style="{StaticResource ModernButtonBase}" Padding="12,7"
                                Margin="0,0,8,8" Click="Donate1_Click"
                                ToolTip="Opens Stripe donation checkout for US$1"/>
                        <Button Content="Donate $3" Style="{StaticResource ModernButtonBase}" Padding="12,7"
                                Margin="0,0,8,8" Click="Donate3_Click"
                                ToolTip="Opens Stripe donation checkout for US$3"/>
                        <Button Content="Donate $5" Style="{StaticResource PrimaryButton}" Padding="12,7"
                                Margin="0,0,8,8" Click="Donate5_Click"
                                ToolTip="Opens Stripe donation checkout for US$5"/>
                    </WrapPanel>

                    <TextBlock Text="Privacy" Style="{StaticResource SectionLabel}" Margin="0,8,0,8"/>
                    <TextBlock Text="• No cloud sync&#10;• Autosave writes only to your chosen .solarproj path&#10;• Recent list is local (%LocalAppData%\solarSim)"
                               Foreground="{DynamicResource TextBrush}" FontSize="12.5" LineHeight="20"/>

                    <TextBlock Text="Updates" Style="{StaticResource SectionLabel}" Margin="0,18,0,8"/>
                    <TextBlock x:Name="UpdateStatusText" Text="Checking…" Foreground="{DynamicResource TextBrush}"
                               FontSize="13" TextWrapping="Wrap"/>

                    <Grid x:Name="UpdateProgressTrack" Margin="0,10,0,6" Height="8" Visibility="Collapsed">
                        <Border Background="{DynamicResource SegmentTrackBrush}" CornerRadius="4"/>
                        <Border x:Name="UpdateProgressFill" HorizontalAlignment="Left"
                                Background="#2DD4BF" CornerRadius="4" Width="0"/>
                    </Grid>
                    <TextBlock x:Name="UpdatePercentText" Text="" Foreground="{DynamicResource MutedBrush}"
                               FontSize="12" Margin="0,0,0,12" MinWidth="48"
                               FontFamily="Consolas, Courier New, monospace"/>

                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button x:Name="CheckUpdateButton" Content="Check for updates" Style="{StaticResource ModernButtonBase}"
                                Padding="12,7" Click="CheckUpdate_Click" Margin="0,0,8,0"/>
                        <Button x:Name="DownloadUpdateButton" Content="Update" Style="{StaticResource PrimaryButton}"
                                Padding="12,7" Click="DownloadUpdate_Click" Margin="0,0,8,0" Visibility="Collapsed"/>
                        <Button x:Name="CancelDownloadButton" Content="Ignore" Style="{StaticResource GhostButton}"
                                Padding="10,7" Click="CancelDownload_Click" Visibility="Collapsed"/>
                    </StackPanel>

                    <CheckBox x:Name="ApplyOnExitCheck" Content="Install when I close the app"
                              IsChecked="True" Margin="0,16,0,0" VerticalAlignment="Center"
                              Foreground="{DynamicResource MutedBrush}" FontSize="13"/>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
