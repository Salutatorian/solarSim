<UserControl x:Class="SolarSim.Preview.AppConfirmDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SolarSim.Preview"
             Width="460"
             MinHeight="160"
             MaxHeight="560"
             Background="{DynamicResource BgBrush}"
             FontFamily="{StaticResource UiFont}"
             Focusable="True"
             PreviewKeyDown="Dialog_PreviewKeyDown">
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            Background="{DynamicResource BgBrush}">
        <DockPanel>
            <Border DockPanel.Dock="Top" Height="40"
                    Background="{DynamicResource ChromeBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <DockPanel Margin="14,0,6,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource DialogChromeButton}"
                            Click="Cancel_Click" ToolTip="Close">
                        <local:AppIcon Kind="Close" Width="12" Height="12"/>
                    </Button>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Style="{StaticResource AppLogoMark}" Width="18" Height="18" Margin="0,0,8,0"
                               VerticalAlignment="Center"/>
                        <TextBlock x:Name="TitleText" Text="Confirm"
                                   FontFamily="{StaticResource DisplayFont}" FontSize="13"
                                   FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="20,12,20,16">
                <Button x:Name="CancelButton" Content="Cancel" MinWidth="96" Margin="0,0,8,0"
                        Style="{StaticResource GhostButton}" Click="Cancel_Click"/>
                <Button x:Name="ConfirmButton" Content="OK" MinWidth="108"
                        Style="{StaticResource PrimaryButton}" Click="Confirm_Click"/>
            </StackPanel>

            <StackPanel Margin="20,18,20,4">
                <TextBlock x:Name="HeadingText" Text="Heading"
                           FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <Border x:Name="BodyBorder" Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,10"
                        Margin="0,0,0,10">
                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="BodyText" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontSize="13" LineHeight="20"/>
                    </ScrollViewer>
                </Border>
                <TextBlock x:Name="FootnoteText" TextWrapping="Wrap"
                           Foreground="{DynamicResource MutedBrush}" FontSize="12" LineHeight="18"
                           Margin="0,0,0,4"/>
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>
