<Window x:Class="SolarSim.Preview.CustomPanelDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Custom Solar Panel"
        Icon="pack://application:,,,/Assets/solarsim-logo.ico"
        Width="420" Height="580"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{DynamicResource BgBrush}"
        FontFamily="{StaticResource UiFont}"
        ShowInTaskbar="False">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            ResizeBorderThickness="0"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            Background="{DynamicResource BgBrush}">
        <DockPanel>
            <Border DockPanel.Dock="Top" Height="40"
                    Background="{DynamicResource ChromeBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <DockPanel Margin="14,0,6,0">
                    <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource DialogChromeButton}"
                            Click="Cancel_Click" ToolTip="Close"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Style="{StaticResource AppLogoMark}" Width="18" Height="18" Margin="0,0,8,0"
                               VerticalAlignment="Center"/>
                        <TextBlock Text="Custom solar panel" FontFamily="{StaticResource DisplayFont}" FontSize="13"
                                   FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="20,0,20,16">
                <Button Content="Cancel" Width="96" Margin="0,0,8,0" Style="{StaticResource GhostButton}" Click="Cancel_Click"/>
                <Button Content="Create Panel" Width="128" Style="{StaticResource PrimaryButton}" Click="Create_Click"/>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="20,16,20,8">
                <StackPanel>
                    <TextBlock Text="Enter datasheet values — dimensions in millimetres."
                               Foreground="{DynamicResource MutedBrush}" FontSize="12.5" Margin="0,0,0,16"/>
                    <TextBlock Text="Manufacturer" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                    <TextBox x:Name="ManufacturerBox" Margin="0,0,0,10"/>
                    <TextBlock Text="Model" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                    <TextBox x:Name="ModelBox" Margin="0,0,0,10"/>
                    <TextBlock Text="Rated Power Pmax (W)" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                    <TextBox x:Name="PmaxBox" Text="400" Margin="0,0,0,10"/>
                    <TextBlock Text="Vmp (V)" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                    <TextBox x:Name="VmpBox" Text="31.25" Margin="0,0,0,10"/>
                    <TextBlock Text="Imp (A)" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                    <TextBox x:Name="ImpBox" Text="12.8" Margin="0,0,0,10"/>
                    <TextBlock Text="Voc (V)" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                    <TextBox x:Name="VocBox" Text="37.1" Margin="0,0,0,10"/>
                    <TextBlock Text="Isc (A)" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                    <TextBox x:Name="IscBox" Text="13.5" Margin="0,0,0,10"/>
                    <TextBlock Text="Width (mm)" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                    <TextBox x:Name="WidthBox" Text="1134" Margin="0,0,0,10"/>
                    <TextBlock Text="Height (mm)" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                    <TextBox x:Name="HeightBox" Text="1722" Margin="0,0,0,10"/>
                    <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                               Visibility="Collapsed" Margin="0,4,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
