<UserControl x:Class="SolarSim.Preview.QuickEstimateWizardWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SolarSim.Preview"
             Width="480"
             Background="{DynamicResource BgBrush}"
             FontFamily="{StaticResource UiFont}"
             Foreground="{DynamicResource TextBrush}"
             Focusable="True"
             PreviewKeyDown="Dialog_PreviewKeyDown">
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            Background="{DynamicResource BgBrush}">
        <DockPanel>
            <Border DockPanel.Dock="Top" Height="40"
                    Background="{DynamicResource ChromeBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <DockPanel Margin="14,0,6,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource DialogChromeButton}"
                            Click="Skip_Click" ToolTip="Skip">
                        <local:AppIcon Kind="Close" Width="12" Height="12"/>
                    </Button>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Style="{StaticResource AppLogoMark}" Width="18" Height="18" Margin="0,0,8,0"
                               VerticalAlignment="Center"/>
                        <TextBlock Text="Your usage"
                                   FontFamily="{StaticResource DisplayFont}" FontSize="13"
                                   FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <DockPanel DockPanel.Dock="Bottom" Margin="20,8,20,16">
                <Button DockPanel.Dock="Left" Content="Skip" Style="{StaticResource GhostButton}"
                        Padding="12,8" Click="Skip_Click" IsCancel="True"/>
                <Button Content="Start designing" Style="{StaticResource PrimaryButton}"
                        Padding="16,8" HorizontalAlignment="Right" Click="Start_Click" IsDefault="True"/>
            </DockPanel>

            <StackPanel Margin="20,18,20,8">
                <TextBlock Text="How much electricity do you use?"
                           FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"
                           TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,16"
                           Text="kWh from the bill is enough to size a starting array. Trace the roof next — everything else you can change on the canvas."/>

                <RadioButton x:Name="PeriodMonth" GroupName="Period" Content="Per month"
                             IsChecked="True" Checked="Period_Changed"/>
                <RadioButton x:Name="PeriodYear" GroupName="Period" Content="Per year"
                             Margin="0,4,0,12" Checked="Period_Changed"/>

                <TextBlock x:Name="KwhLabel" Text="kWh per month" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                <TextBox x:Name="KwhBox" Height="36" FontSize="16" Padding="10,0"
                         VerticalContentAlignment="Center"/>
                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,6,0,0"
                           Text="A full year is more accurate if you have it."/>

                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}"
                           TextWrapping="Wrap" Visibility="Collapsed" Margin="0,12,0,0"/>
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>
