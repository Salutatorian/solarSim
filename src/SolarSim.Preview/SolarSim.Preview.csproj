<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>SolarSim.Preview</RootNamespace>
    <AssemblyName>solarSim</AssemblyName>
    <ApplicationTitle>solarSim</ApplicationTitle>
    <Product>solarSim</Product>
    <Version>0.1.16</Version>
    <AssemblyVersion>0.1.16.0</AssemblyVersion>
    <FileVersion>0.1.16.0</FileVersion>
    <InformationalVersion>0.1.16</InformationalVersion>
    <Company>solarSim</Company>
    <Description>Visual solar design lab for Windows (design aid — not stamped approval). Local projects only; proprietary — see LICENSE.</Description>
    <ApplicationIcon>Assets\solarsim-logo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SolarSim.Domain\SolarSim.Domain.csproj" />
    <ProjectReference Include="..\SolarSim.Application\SolarSim.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="whats-new.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Tools\pvlib_estimate.py" Link="Tools\pvlib_estimate.py" CopyToOutputDirectory="PreserveNewest" />
    <None Include="SiteMap\satellite-picker.html" CopyToOutputDirectory="PreserveNewest" />
    <None Include="SiteMap\leaflet.css" CopyToOutputDirectory="PreserveNewest" />
    <None Include="SiteMap\leaflet.js" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Assets\panel-face.png" />
    <Resource Include="Assets\solarsim-logo.png" />
    <Resource Include="Assets\solarsim-logo.ico" />
    <Resource Include="Assets\combiner-6string.png" />
    <Resource Include="Assets\inverter-anenji-12kw.png" />
    <Resource Include="Assets\inverter-anenji-4_2kw.png" />
    <Resource Include="Assets\inverter-anenji-6_5kw.png" />
    <Resource Include="Assets\battery-anenji-16kwh.png" />
    <Resource Include="Assets\battery-anenji-12_8v-300ah.png" />
    <Resource Include="Assets\battery-anenji-10kw.png" />
    <Resource Include="Assets\battery-anenji-5_1kwh-rack.png" />
    <Resource Include="Assets\disconnect-pv-isolator.png" />
    <Resource Include="Assets\battery-disconnect-dhm1b.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
  </ItemGroup>

</Project>
